{
  "name": "lau-pau-tienda",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda online de Lau&Pau: catálogo bilingüe, carrito, pago con Redsys, área de cliente y panel de administración.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start -p ${PORT:-3000}",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:build": "node demo/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.27",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
