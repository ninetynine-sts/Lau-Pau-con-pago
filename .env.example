# Copia este archivo a .env en local. En Hostinger, estas variables van en el
# panel de la Web App (Environment variables), no en un archivo.

# URL pública de la tienda, sin barra final. Redsys vuelve aquí tras pagar.
SITE_URL=https://www.laupau.ad

# Base de datos PostgreSQL (Neon u otro). Sin ella se usa PGlite en ./.data:
# vale para local, NO para producción.
DATABASE_URL=

# Primera cuenta del panel /admin. Solo se crea si todavía no hay ninguna.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Redsys (TPV Virtual del banco, modalidad Redirección) -------------------
# test = entorno de pruebas de Redsys; production = cobra de verdad.
REDSYS_ENV=test
# Sin estas tres se usa el comercio genérico de pruebas de Redsys.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
# Solo si el banco da una URL de pasarela distinta a la estándar de Redsys.
REDSYS_URL=

# --- Correo (Resend) ---------------------------------------------------------
# Sin clave, los correos se guardan en la tabla email_log y no se envían.
RESEND_API_KEY=
MAIL_FROM=Lau&Pau <hola@laupau.ad>
MAIL_REPLY_TO=comercial@exitekta.ad

# --- Fotos de producto (Cloudflare R2) ----------------------------------------
# Sin R2 se guardan en UPLOAD_DIR (solo local: en Hostinger se pierden al redesplegar).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
UPLOAD_DIR=./uploads
